from itertools import product as prod
'''
prod( ) is a generator that realizes the cartesian product; for instance 
prod((0,1), repeat = 3) is a generator of all tuples of 0's and 1's of length 3
Note that, prod( ) can be applied to generators; for instance, we can use 
prod(prim_roots(p), range(p-1)) for a prime p. 

SageMath has a useful function 'product' and it does a different thing; for 
instance, for permutations a, b, c, product([a, b, c]) returns the product a*b*c
'''

from itertools import combinations as comb
'''
for instance, comb([1,2,3], 2) generates (1,2), (1,3) and (2,3)
'''

from pickle import dump, load
#this is for storing and loading the results
'''
How to use 'pickle':
Given a Python/SageMath object obJecT, we can store it in the file FILE 
by doing this:
    
dump(obJecT,open('FILE','wb'))

To unpickle the obJecT back, we do this:
    
FO = open('FILE','rb'); obJecT = load(FO)

Another option is to use the function load_now. One should 
not forget to use ' ' around the name of the file. 
'''

'''
loads (unpickles) the object from the FILE 'FileName'; 
one should not forget to use ' '.
'''
#tested
def load_now(FILE):
    FO = open(FILE,'rb')
    return load(FO)

